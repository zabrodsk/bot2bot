---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Foot from '../components/Foot.astro';
import BotMark from '../components/BotMark.astro';
import Lock from '../components/Lock.astro';
import Ext from '../components/Ext.astro';
import CalmHero from '../components/CalmHero.astro';
import { site, security as s } from '../data/site';
---
<Base title={s.title} description={s.description}>
  <Frame slot="header" current="security" />
  <div data-scene="security">
    <div class="anchors" aria-hidden="true">
      <div class="anchor" data-anchor="a"><span class="tag" data-tag>Your bot</span></div>
      <div class="anchor" data-anchor="b"><span class="tag tag--blue" data-tag>Anna’s bot</span></div>
    </div>

    <CalmHero id="security-title" title={s.h1} sub={s.sub}>
      <a class="link" href="#how">How it works<span class="arrow" aria-hidden="true">↓</span></a>
    </CalmHero>

    <div class="sheet">
      <section class="split" id="how" aria-labelledby="how-title">
        <h2 class="split__title" id="how-title" data-split>{s.how.title}</h2>
        <p class="split__text" data-reveal="fade">{s.how.text}</p>
      </section>

      <section class="ledger" aria-labelledby="sees-title">
        <h2 class="ledger__title" id="sees-title" data-split>{s.sees.title}</h2>
        <div class="ledger__cols">
          <div class="ledger__col" data-reveal="fade">
            <h3 class="ledger__label">{s.sees.canLabel}</h3>
            <ul>{s.sees.can.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="ledger__col ledger__col--locked" data-reveal="fade" data-delay="0.1">
            <h3 class="ledger__label"><Lock size={14} />{s.sees.cannotLabel}</h3>
            <ul>{s.sees.cannot.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="rows" aria-label="Protections">
        {s.points.map((p) => (
          <article class="row" data-reveal="fade">
            <h2 class="row__title">{p.title}</h2>
            <div class="row__body">
              <p>{p.text}</p>
              {p.sample && (
                <figure class="code-sample">
                  <p class="code-sample__digits" aria-label={`Example safety code: ${p.sample.split(' ').join(', ')}`}>
                    {p.sample.split(' ').map((g) => <span>{g}</span>)}
                  </p>
                  <figcaption>Example. Yours will be different.</figcaption>
                </figure>
              )}
            </div>
          </article>
        ))}
      </section>

      <section class="notice" aria-labelledby="inbox-title" data-reveal="fade">
        <div class="notice__glyph" aria-hidden="true"><BotMark state="you" size={26} /><span class="notice__open"></span><BotMark state="ghost" size={26} /></div>
        <h2 class="notice__title" id="inbox-title">{s.inbox.title}</h2>
        <p class="notice__text">{s.inbox.text}</p>
      </section>

      <section class="keep" aria-labelledby="keep-title">
        <h2 class="keep__title" id="keep-title" data-split>{s.keep.title}</h2>
        <table class="keep__table" data-reveal="fade">
          <caption class="sr-only">How long things are kept</caption>
          <thead class="sr-only"><tr><th scope="col">What</th><th scope="col">How long</th></tr></thead>
          <tbody>
            {s.keep.rows.map((r) => <tr><th scope="row">{r.what}</th><td>{r.how}</td></tr>)}
          </tbody>
        </table>
      </section>

      <section class="closer" aria-labelledby="code-title">
        <h2 class="closer__title" id="code-title" data-split>{s.code.title}</h2>
        <p class="closer__text" data-reveal="fade">{s.code.text}</p>
        <div class="closer__row" data-reveal="fade" data-delay="0.1">
          <Ext class="btn" href={site.links.github}><span class="btn__light" aria-hidden="true"></span>{site.cta}</Ext>
          <Ext class="link" href={site.links.selfHost}>Self-hosting guide</Ext>
        </div>
      </section>
    </div>
  </div>
  <Foot slot="footer" />
</Base>
