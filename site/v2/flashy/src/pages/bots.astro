---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Foot from '../components/Foot.astro';
import Ext from '../components/Ext.astro';
import CalmHero from '../components/CalmHero.astro';
import { site, bots as b } from '../data/site';
---
<Base title={b.title} description={b.description}>
  <Frame slot="header" current="bots" />
  <div data-scene="bots">
    <div class="anchors" aria-hidden="true">
      <div class="anchor" data-anchor="you"><span class="tag tag--blue" data-tag>Your bot</span></div>
    </div>

    <CalmHero id="bots-title" title={b.h1} sub={b.sub}>
      <Ext class="btn" href={site.links.setupBot}><span class="btn__light" aria-hidden="true"></span>Add the setup bot</Ext>
      <Ext class="link" href={site.links.skill}>Read the skill</Ext>
    </CalmHero>

    <div class="sheet">
      <section class="split" aria-labelledby="learns-title">
        <div>
          <h2 class="split__title" id="learns-title" data-split>{b.learns.title}</h2>
          <p class="split__lead" data-reveal="fade">{b.learns.text}</p>
        </div>
        <dl class="pair-list" data-reveal="fade" data-delay="0.1">
          {b.learns.items.map((x) => <div><dt>{x.name}</dt><dd>{x.text}</dd></div>)}
        </dl>
      </section>

      <section class="says" aria-labelledby="says-title">
        <h2 class="says__title" id="says-title" data-split>{b.says.title}</h2>
        <ul class="says__list">
          {b.says.rows.map((r, i) => (
            <li class="says__row" data-reveal="fade" data-delay={String(i * 0.06)}>
              <p class="says__you"><span class="sr-only">You: </span>{r.you}</p>
              <p class="says__bot"><span class="sr-only">Your bot: </span>{r.bot}</p>
            </li>
          ))}
        </ul>
        <p class="says__note" data-reveal="fade">{b.says.note}</p>
      </section>

      <section class="split" aria-labelledby="doorbell-title">
        <h2 class="split__title" id="doorbell-title" data-split>{b.doorbell.title}</h2>
        <p class="split__text" data-reveal="fade">{b.doorbell.text}</p>
      </section>

      <section class="self" aria-labelledby="self-title">
        <h2 class="self__title" id="self-title" data-split>{b.self.title}</h2>
        <p class="self__text" data-reveal="fade">{b.self.text}</p>
        <div class="cmd" data-reveal="fade" data-delay="0.1">
          <code class="cmd__code"><span class="cmd__prompt" aria-hidden="true">$</span>{b.self.command}</code>
          <button class="cmd__copy" type="button" data-copy={b.self.command}><span data-copy-label>Copy</span><span class="sr-only"> command</span></button>
        </div>
      </section>

      <section class="docs" aria-labelledby="docs-title">
        <h2 class="docs__title" id="docs-title" data-split>Read the docs.</h2>
        <ul class="docs__list">
          {b.docs.map((d) => (
            <li data-reveal="fade">
              <Ext class="doc" href={site.links[d.href]}>
                <span class="doc__label">{d.label}</span>
                <span class="doc__text">{d.text}</span>
                <span class="doc__arrow" aria-hidden="true">↗</span>
              </Ext>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
  <Foot slot="footer" />
</Base>
