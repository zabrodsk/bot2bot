---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Foot from '../components/Foot.astro';
import BotMark from '../components/BotMark.astro';
import { notFound } from '../data/site';
---
<Base title={notFound.title} description={notFound.description} noindex>
  <Frame slot="header" current="none" />
  <div data-scene="lost">
    <div class="anchors" aria-hidden="true">
      <div class="anchor" data-anchor="missing"><span class="tag" data-tag style="visibility:visible;opacity:1">404</span></div>
    </div>
    <section class="lost" aria-labelledby="lost-title">
      <h1 class="lost__title" id="lost-title" data-reveal="open" data-intro>{notFound.h1}</h1>
      <p class="lost__text" data-reveal="open" data-intro data-delay="0.12">{notFound.text}</p>
      <div class="lost__row" data-reveal="fade" data-intro data-delay="0.25">
        <a class="btn" href="/"><span class="btn__light" aria-hidden="true"></span>{notFound.back}</a>
        <a class="link" href="/security/">Security</a>
        <a class="link" href="/pricing/">Pricing</a>
      </div>
      <div class="lost__ghost" aria-hidden="true"><BotMark state="ghost" size={22} /><span class="tag">404</span></div>
    </section>
  </div>
  <Foot slot="footer" />
</Base>
