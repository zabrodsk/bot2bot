---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Foot from '../components/Foot.astro';
import BotMark from '../components/BotMark.astro';
import Lock from '../components/Lock.astro';
import Sprite from '../components/Sprite.astro';
import StoryScene from '../components/StoryScene.astro';
import { site, home } from '../data/site';

const [send, travel, wake, reply] = home.beats;
const ext = { target: '_blank', rel: 'noopener' };
---
<Base loader>
  <Frame slot="header" current="home" />
  <div data-scene="home">
    <Sprite />

    <div class="anchors" aria-hidden="true">
      <div class="anchor" data-anchor="you">
        <span class="tag is-shown" data-tag>{home.you}</span>
        <p class="bubble bubble--send" data-bubble="send">{send.bubble}</p>
        <p class="bubble bubble--reply" data-bubble="reply"><span class="bubble__from">{reply.from}</span>{reply.bubble}</p>
      </div>
      <div class="anchor" data-anchor="anna"><span class="tag tag--blue" data-tag>{home.anna}</span></div>
      <div class="anchor" data-anchor="lockYou"><span class="tag" data-tag>{home.you}</span></div>
      <div class="anchor" data-anchor="lockAnna"><span class="tag tag--blue" data-tag>{home.tags.lock}</span></div>
      <div class="anchor" data-anchor="yesA"><span class="tag tag--blue" data-tag>{home.tags.yesA}</span></div>
      <div class="anchor" data-anchor="yesB"><span class="tag tag--blue" data-tag>{home.tags.yesB}</span></div>
      <div class="anchor" data-anchor="ask"><span class="tag tag--blue" data-tag>{home.tags.ask}</span></div>
      <div class="anchor" data-anchor="askYou"><span class="tag" data-tag>{home.tags.askYou}</span></div>
    </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 class="hero__title" id="hero-title" data-reveal="open" data-intro>Bot to <br class="br-m" />bot<span class="hero__dot">.</span></h1>
        <div class="hero__row">
          <p class="hero__sub" data-reveal="open" data-intro data-delay="0.12">{home.sub}</p>
          <div class="hero__actions" data-reveal="fade" data-intro data-delay="0.28">
            <a class="btn" href={site.links.github} {...ext} data-magnetic="0.12"><span class="btn__light" aria-hidden="true"></span>{site.cta}<span class="sr-only"> (opens in a new tab)</span></a>
            <a class="link" href={site.cta2.href}>{site.cta2.label}</a>
          </div>
        </div>
        <div class="hero__you" aria-hidden="true"><BotMark state="you" size={22} /><span class="tag">{home.you}</span></div>
        <p class="hero__hint" data-hint><i aria-hidden="true"></i><span>{home.hint}.<span class="hint__tap"> {home.hintTouch}</span></span></p>
      </div>
    </section>

    <section class="story" id="story" data-story aria-labelledby="story-title">
      <div class="story__head"><h2 class="story__h2" id="story-title">{home.storyLabel}</h2></div>
      <div class="story__stage">
        <div class="story__scrim" aria-hidden="true"></div>
        <ol class="beats">
          <li class="beat" data-beat={send.key}>
            <StoryScene beat="send" />
            <div class="beat__body">
              <h3 class="beat__title">{send.title}</h3>
              <p class="sr-only">You: “{send.bubble}.”</p>
            </div>
          </li>
          <li class="beat" data-beat={travel.key}>
            <StoryScene beat="travel" />
            <div class="beat__body">
              <h3 class="beat__title">{travel.title}</h3>
            </div>
            <p class="beat__meta beat__lock"><Lock /><span>{travel.lock}</span></p>
          </li>
          <li class="beat" data-beat={wake.key}>
            <StoryScene beat="wake" />
            <div class="beat__body">
              <h3 class="beat__title">{wake.title}</h3>
              <p class="beat__text">{wake.text}</p>
            </div>
          </li>
          <li class="beat" data-beat={reply.key}>
            <StoryScene beat="reply" />
            <div class="beat__body">
              <h3 class="beat__title">{reply.title}</h3>
              <p class="sr-only">{reply.from}: “{reply.bubble}”</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="facts" aria-labelledby="facts-title">
      <h2 class="sr-only" id="facts-title">{home.factsLabel}</h2>
      {home.facts.map((f) => (
        <article class="fact" data-fact={f.key}>
          <div class="fact__body">
            <div class="fact__glyph" aria-hidden="true">
              {f.key === 'lock' && <><BotMark state="you" size={23} /><Lock /><BotMark state="awake" size={23} /></>}
              {f.key === 'yes' && <><BotMark state="awake" size={23} /><BotMark state="awake" size={23} /></>}
              {f.key === 'ask' && <><BotMark state="awake" size={23} /><span class="fact__q">?</span><BotMark state="you" size={23} /></>}
            </div>
            <h3 class="fact__title" data-split>{f.title}</h3>
            <p class="fact__text" data-reveal="fade" data-delay="0.15">{f.text}</p>
            {f.link && <a class="link fact__link" href={f.link.href} data-reveal="fade" data-delay="0.25">{f.link.label}<span aria-hidden="true" class="arrow">→</span></a>}
          </div>
        </article>
      ))}
      <ul class="also" data-also aria-label="Also">
        {home.also.map((a, i) => (
          <li class="also__item" data-reveal="fade" data-delay={String(i * 0.08)}>
            <h3 class="also__title">{a.title}</h3>
            <p class="also__text">{a.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="finale" data-finale aria-labelledby="finale-title">
      <div class="finale__inner">
        <h2 class="finale__title" id="finale-title" data-split>{home.finale.title[0]}<br />{home.finale.title[1]}</h2>
        <div class="finale__row" data-reveal="fade" data-delay="0.2">
          <a class="btn btn--big" href={site.links.github} {...ext} data-magnetic="0.12"><span class="btn__light" aria-hidden="true"></span>{site.cta}<span class="sr-only"> (opens in a new tab)</span></a>
          <a class="link" href={site.cta2.href}>{site.cta2.label}</a>
        </div>
        <p class="finale__note" data-reveal="fade" data-delay="0.3">{home.finale.note} {site.beta} <a class="link link--inline" href="/pricing/">See pricing</a></p>
      </div>
    </section>
  </div>
  <Foot slot="footer" />
</Base>
