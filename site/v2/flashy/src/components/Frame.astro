---
import BotMark from './BotMark.astro';
import { site, type PageKey } from '../data/site';
interface Props { current?: PageKey }
const { current = 'none' } = Astro.props;
---
<header class="frame">
  <a class="mark" href="/" aria-label={`${site.name}, home`} aria-current={current === 'home' ? 'page' : undefined}>
    <BotMark state="you" size={22} />
    <span>{site.name}</span>
  </a>
  <nav class="nav" aria-label="Main">
    {site.nav.map((n) => (
      <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
    ))}
    <a class="nav__gh" href={site.links.github} target="_blank" rel="noopener">GitHub<span class="sr-only"> (opens in a new tab)</span><span class="nav__ext" aria-hidden="true">↗</span></a>
  </nav>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
    <span class="menu-btn__label">Menu</span>
    <span class="menu-btn__eyes" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>
<div class="menu" id="menu" hidden data-menu>
  <nav aria-label="Menu">
    <ul class="menu__list">
      <li><a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a></li>
      {site.nav.map((n) => (
        <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
      ))}
      <li><a href={site.links.github} target="_blank" rel="noopener">GitHub<span class="sr-only"> (opens in a new tab)</span><span class="nav__ext" aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
</div>
