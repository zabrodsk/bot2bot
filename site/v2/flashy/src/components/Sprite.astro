---
// Bot symbols for the drawn (no-GL) frames. Colors are baked in: <use> clones can't inherit state classes.
const states = {
  s: { head: '#0f1420', line: '#2e384c', eye: '#2e384c', light: '#2e384c', open: false },
  l: { head: '#111726', line: '#56637d', eye: '#56637d', light: '#3d4f8f', open: false },
  a: { head: '#151d2e', line: '#eef2f8', eye: '#eef2f8', light: '#6f8cff', open: true },
  y: { head: '#eef2f8', line: '#eef2f8', eye: '#0b0f18', light: '#6f8cff', open: true },
};
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="halo"><stop offset="0" stop-color="#6f8cff" stop-opacity="0.75" /><stop offset="1" stop-color="#2747c9" stop-opacity="0" /></radialGradient>
    {Object.entries(states).map(([k, c]) => (
      <symbol id={`b${k}`} viewBox="-11 -14 22 23" overflow="visible">
        {c.light === '#6f8cff' && <circle cx="0" cy="-10.5" r="6" fill="url(#halo)" />}
        <line x1="0" y1="-6" x2="0" y2="-9" stroke={c.line} stroke-width="1.3" stroke-linecap="round" />
        <circle cx="0" cy="-10.5" r="1.8" fill={c.light} />
        <rect x="-8" y="-6" width="16" height="13" rx="4" fill={c.head} stroke={c.line} stroke-width="1.3" />
        {c.open
          ? <><rect x="-4.6" y="-1.4" width="3" height="3.4" rx="1" fill={c.eye} /><rect x="1.6" y="-1.4" width="3" height="3.4" rx="1" fill={c.eye} /></>
          : <path d="M-4.6 0.3h3M1.6 0.3h3" stroke={c.eye} stroke-width="1.2" stroke-linecap="round" />}
      </symbol>
    ))}
    <symbol id="bg" viewBox="-11 -14 22 23" overflow="visible">
      <rect x="-8" y="-6" width="16" height="13" rx="4" fill="none" stroke="#4a556b" stroke-width="1.3" stroke-dasharray="2.6 2.2" />
    </symbol>
  </defs>
</svg>
