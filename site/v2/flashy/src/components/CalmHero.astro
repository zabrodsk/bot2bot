---
// The hero of the calmer inner pages: a poster headline over the field, which then rests
// under a solid sheet while you read.
interface Props { id: string; title: string; sub: string }
const { id, title, sub } = Astro.props;
---
<section class="calm-hero" aria-labelledby={id}>
  <h1 class="calm-hero__title" id={id} data-reveal="open" data-intro>{title}</h1>
  <p class="calm-hero__sub" data-reveal="open" data-intro data-delay="0.12">{sub}</p>
  <div class="calm-hero__actions" data-reveal="fade" data-intro data-delay="0.24"><slot /></div>
</section>
