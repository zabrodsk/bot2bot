---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import { notFound, home } from '../data/site';
---
<Base title={notFound.title} description={notFound.description} noindex>
  <section class="miss" aria-labelledby="miss-title" data-field-scope>
    <Field mode="miss" you={home.you} />
    <div class="miss__band">
      <h1 id="miss-title" class="miss__title">{notFound.headline}</h1>
      <a class="button" href={notFound.cta.href}><span class="button__light" aria-hidden="true"></span>{notFound.cta.label}</a>
    </div>
  </section>
</Base>

<style>
  .miss {
    height: calc(100svh - var(--header-h)); min-height: 520px;
    display: grid; grid-template-rows: minmax(0, 1fr) auto;
    padding: clamp(8px, 2.6vh, 28px) var(--m) clamp(28px, 6.4vh, 64px);
  }
  .miss__band {
    display: flex; align-items: flex-end; justify-content: space-between; gap: var(--gap);
    padding-top: clamp(30px, 6vh, 64px);
  }
  .miss__title {
    font-family: var(--f-display); font-weight: 440; font-size: var(--t-xl);
    line-height: 0.92; letter-spacing: -0.05em; margin-left: -0.05em; max-width: 12ch;
    text-box: trim-both cap alphabetic;
  }
  @media (max-width: 699px) {
    .miss__band { flex-direction: column; align-items: stretch; gap: 26px; }
  }
</style>
