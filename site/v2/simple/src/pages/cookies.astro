---
import LegalPage from '../components/LegalPage.astro';
import Button from '../components/arc/Button.astro';
import { cookies } from '../data/site';
---
<LegalPage path="/cookies/" page={cookies}>
  <div class="settings">
    <Button variant="secondary" data-cookie-settings aria-haspopup="dialog">{cookies.settings}</Button>
  </div>
</LegalPage>

<style>
  .settings { padding-top: 4px; }
</style>
