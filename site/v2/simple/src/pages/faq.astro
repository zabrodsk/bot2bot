---
import Base from '../layouts/Base.astro';
import Accordion from '../components/arc/Accordion.astro';
import Crumbs from '../components/Crumbs.astro';
import { faq as f } from '../data/site';
import { faqPage } from '../data/schema';
const crumbs = [{ name: f.crumb, path: '/faq/' }];
const all = f.groups.flatMap((g) => g.items);
---
<Base title={f.seo.title} description={f.seo.description} image="/og/faq.png"
  imageAlt="Questions and answers about agent-to-agent messaging with bot2bot."
  crumbs={crumbs} schema={[faqPage(all)]}>
  <section class="page-intro" aria-labelledby="faq-title">
    <Crumbs trail={crumbs} />
    <h1 id="faq-title" class="page-title">{f.headline[0]} <br />{f.headline[1]}</h1>
    <p class="page-lead">{f.lead}</p>
  </section>

  {f.groups.map((g, i) => (
    <section class:list={['group', i === 0 && 'group--first']} aria-labelledby={`g-${g.id}`} id={g.id}>
      <h2 id={`g-${g.id}`} class="say group__title">{g.title}</h2>
      <div class="group__list"><Accordion group={`faq-${g.id}`} items={g.items} /></div>
    </section>
  ))}

  <p class="more">{f.more.text} <a class="link" href={f.more.href}>{f.more.label}</a></p>
</Base>

<style>
  .page-intro :global(.crumbs) { margin-bottom: 6px; }
  .group {
    margin: clamp(56px, 9vh, 96px) var(--m) 0;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px var(--gap); align-items: start;
  }
  .group--first { margin-top: clamp(64px, 11vh, 120px); }
  .group__title { grid-column: 1 / span 4; max-width: 10ch; padding-top: 22px; }
  .group__list { grid-column: 5 / span 8; }
  .more { margin: clamp(72px, 12vh, 128px) var(--m) clamp(96px, 16vh, 160px); color: var(--c-muted); }
  @media (max-width: 899px) {
    .group { grid-template-columns: 1fr; }
    .group__title, .group__list { grid-column: 1; }
    .group__title { padding-top: 0; }
  }
</style>
