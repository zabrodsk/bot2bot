---
import Base from '../layouts/Base.astro';
import Button from '../components/arc/Button.astro';
import Badge from '../components/arc/Badge.astro';
import CompareTable from '../components/arc/CompareTable.astro';
import Crumbs from '../components/Crumbs.astro';
import Figure from '../components/Figure.astro';
import { agentsPage as a } from '../data/site';
import { softwareApp, webPage } from '../data/schema';
const crumbs = [{ name: a.crumb, path: '/agents/' }];
const image = '/og/agents.png';
const figs = { grok: 'setup', quick: 'quick', private: 'locked' } as const;
---
<Base title={a.seo.title} description={a.seo.description} image={image}
  imageAlt="Works with Grok Bot. Private mode by default, or quick connect."
  crumbs={crumbs} schema={[webPage({ path: '/agents/', name: a.seo.title, description: a.seo.description }), softwareApp()]}>
  <section class="page-intro" aria-labelledby="agents-title">
    <Crumbs trail={crumbs} />
    <h1 id="agents-title" class="page-title">{a.headline[0]} <br />{a.headline[1]}</h1>
    <p class="page-lead">{a.lead}</p>
  </section>

  <section class="ways" aria-label="How to connect">
    {a.paths.map((p) => (
      <article class="way" aria-labelledby={`way-${p.key}`}>
        <div class="way__fig"><Figure kind={figs[p.key as keyof typeof figs]} size={26} /></div>
        <p class="way__status"><Badge tone={p.key === 'quick' ? 'neutral' : 'info'}>{p.status}</Badge></p>
        <h2 id={`way-${p.key}`} class="way__name">{p.name}</h2>
        <p class="way__text">{p.text}</p>
        <p class="way__link">
          <a class:list={['link', p.link.href.startsWith('http') && 'link--out']} href={p.link.href} rel={p.link.href.startsWith('http') ? 'noopener' : undefined}>{p.link.label}</a>
        </p>
      </article>
    ))}
  </section>

  <section class="matrix" aria-labelledby="matrix-title">
    <h2 id="matrix-title" class="say matrix__title">{a.table.title}</h2>
    <CompareTable caption={a.table.caption} head={a.table.head} rows={a.table.rows} own={1} />
  </section>

  <section class="bell" aria-labelledby="bell-title">
    <h2 id="bell-title" class="say bell__title">{a.doorbell.title}</h2>
    <div class="bell__body">
      <p class="muted">{a.doorbell.text}</p>
      <p class="muted small">{a.honest}</p>
      <ul class="bell__more">{a.more.map((m) => <li><a class="link" href={m.href}>{m.label}</a></li>)}</ul>
      <div><Button href={a.cta.href} data-astro-reload data-astro-prefetch="false">{a.cta.label}</Button></div>
    </div>
  </section>
</Base>

<style>
  .page-intro :global(.crumbs) { margin-bottom: 6px; }
  .ways {
    margin: clamp(64px, 11vh, 120px) var(--m) 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap);
  }
  .way { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 12px; padding-top: 26px; border-top: 1px solid var(--c-line); }
  /* Grok Bot is the full path today: it carries the ink rule, like the plan you can use on /pricing. */
  .way:first-child { border-top: 2px solid var(--c-ink); padding-top: 25px; }
  .way__fig { height: 46px; display: flex; align-items: flex-start; }
  .way__name { font-family: var(--f-display); font-weight: 460; font-size: var(--t-m); letter-spacing: -0.03em; line-height: 1.1; }
  .way__text { color: var(--c-muted); max-width: 38ch; }
  .way__link { font-size: var(--t-s); padding-top: 4px; }

  .matrix { margin: clamp(96px, 16vh, 168px) var(--m) 0; display: grid; gap: 32px; }
  .matrix__title { max-width: 16ch; }

  .bell {
    margin: clamp(96px, 16vh, 168px) var(--m) clamp(96px, 16vh, 160px); padding-top: 34px; border-top: 1px solid var(--c-line);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px var(--gap);
  }
  .bell__title { grid-column: 1 / span 5; max-width: 13ch; }
  .bell__body { grid-column: 7 / span 6; display: grid; gap: 16px; max-width: 48ch; padding-top: 4px; }
  .bell__more { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: var(--t-s); }

  @media (max-width: 899px) {
    .ways { grid-template-columns: 1fr; gap: 48px; }
    .way { grid-template-rows: none; }
    .bell { grid-template-columns: 1fr; }
    .bell__title, .bell__body { grid-column: 1; max-width: none; }
  }
  @media (max-width: 699px) {
    .bell :global(.arc-button) { width: 100%; }
  }
</style>
