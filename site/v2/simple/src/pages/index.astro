---
import Base from '../layouts/Base.astro';
import AskAnswers from '../components/bencho/AskAnswers.astro';
import ConnectDemo from '../components/home/ConnectDemo.astro';
import NeverDemo from '../components/home/NeverDemo.astro';
import QuietNight from '../components/home/QuietNight.astro';
import Row from '../components/home/Row.astro';
import Button from '../components/arc/Button.astro';
import Field from '../components/Field.astro';
import { home } from '../data/site';
import { softwareApp } from '../data/schema';
const app = softwareApp();
---
<Base title={home.seo.title} description={home.seo.description} schema={[app]}>
  <section class="hero" aria-labelledby="hero-title" data-field-scope>
    <Field class="hero__field" mode="wake" names={home.friends} you={home.you} />
    <div class="hero__band">
      <h1 id="hero-title" class="hero__title">{home.headline[0]} <span data-anchor>{home.headline[1]}</span></h1>
      <div class="hero__aside">
        <p class="hero__sub"><span class="hero__lead">{home.sub[0]}</span> <br class="br" />{home.sub[1]}</p>
        <div class="hero__actions">
          <Button href={home.cta.href} data-wake-you data-astro-reload data-astro-prefetch="false">{home.cta.label}</Button>
          <a class="link link--out" href={home.secondary.href} rel="noopener">{home.secondary.label}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="rows" aria-label="How it works">
    {home.rows.map((row) => (
      <Row fig={row.key === 'connect' ? 'setup' : (row.key as 'locked' | 'ask')} title={row.title} text={row.text} link={row.link}>
        {row.key === 'ask' && <AskAnswers {...home.ask} />}
        {row.key === 'connect' && <ConnectDemo {...home.connect} />}
      </Row>
    ))}
  </section>

  <section class="quiet" aria-labelledby="quiet-title">
    <QuietNight {...home.quiet} />
  </section>

  <section class="rows rows--more" aria-label="Safety">
    {home.more.map((row) => (
      <Row fig="never" title={row.title} text={row.text} link={row.link}>
        {row.key === 'never' && <NeverDemo {...home.never} />}
      </Row>
    ))}
  </section>

  <section class="close" aria-labelledby="close-title">
    <h2 id="close-title" class="close__title">{home.close.title}</h2>
    <p class="close__text muted">{home.close.text}</p>
    <div class="close__actions">
      <Button href={home.cta.href} data-astro-reload data-astro-prefetch="false">{home.cta.label}</Button>
      <Button href={home.close.pricing.href} variant="secondary">{home.close.pricing.label}</Button>
    </div>
  </section>
</Base>

<style>
  .hero {
    height: calc(100svh - var(--header-h));
    min-height: 600px;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    padding: clamp(8px, 2.6vh, 28px) var(--m) clamp(28px, 6.4vh, 64px);
  }
  .hero__band {
    display: flex; align-items: flex-end; justify-content: space-between; gap: var(--gap);
    padding-top: clamp(30px, 6vh, 64px);
  }
  .hero__title {
    font-family: var(--f-display);
    font-weight: 440;
    font-size: var(--t-hero);
    line-height: 0.86;
    letter-spacing: -0.05em;
    margin-left: -0.055em; /* optical: the B's side bearing, so the stem sits on the margin */
    white-space: nowrap;
    text-box: trim-both cap alphabetic;
  }
  .hero__aside { flex: 0 0 auto; display: grid; justify-items: start; gap: 24px; padding-bottom: 2px; }
  .hero__sub { font-size: var(--t-body); color: var(--c-muted); line-height: 1.5; max-width: 30ch; }
  .hero__lead { color: var(--c-ink); }
  .hero__actions { display: flex; align-items: center; gap: 24px; }
  .hero__actions .link { font-size: 1rem; }

  /* Facts, one per row (Row.astro). The figure's wire says whether a chat is encrypted. */
  .rows { margin: clamp(56px, 12vh, 128px) var(--m) 0; }
  .rows--more { margin-top: 0; }
  .rows--more > :global(.row:first-child) { border-top: 0; }

  /* Quiet hours: one night, full bleed, pinned while you scroll through it (QuietNight.astro). */
  .quiet { margin-top: clamp(24px, 5vh, 56px); }

  /* The close: one plain line about price, and the two ways in. */
  .close {
    padding: clamp(96px, 16vh, 168px) var(--m) clamp(96px, 16vh, 160px);
    display: grid; gap: 22px; justify-items: start;
  }
  .close__title {
    font-family: var(--f-display); font-weight: 440; font-size: var(--t-l);
    line-height: 1; letter-spacing: -0.045em; margin-left: -0.04em;
  }
  .close__text { max-width: 40ch; }
  .close__actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }

  @media (max-width: 899px) {
    .hero__band { flex-direction: column; align-items: stretch; gap: 22px; }
    .hero__aside { gap: 22px; }
  }
  @media (max-width: 699px) {
    .hero { min-height: 620px; padding-bottom: max(20px, env(safe-area-inset-bottom)); }
    .hero__band { padding-top: 30px; }
    .hero__title { font-size: min(19.4vw, 5.6rem); }
    .hero__sub { font-size: 1.0625rem; }
    .hero__aside, .hero__actions { justify-items: stretch; }
    .hero__actions { flex-direction: column; align-items: stretch; gap: 14px; }
    .hero__actions .link { align-self: center; padding: 6px 0; }
    .close__actions { width: 100%; flex-direction: column; }
  }
</style>
