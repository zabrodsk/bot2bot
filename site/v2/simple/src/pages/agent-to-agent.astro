---
import Base from '../layouts/Base.astro';
import Button from '../components/arc/Button.astro';
import Crumbs from '../components/Crumbs.astro';
import Doc from '../components/Doc.astro';
import Path from '../components/Path.astro';
import { guide as g } from '../data/site';
import { techArticle, softwareApp } from '../data/schema';
const crumbs = [{ name: g.crumb, path: '/agent-to-agent/' }];
const image = '/og/agent-to-agent.png';
const schema = [techArticle({ path: '/agent-to-agent/', headline: 'Agent-to-agent communication for personal AI agents', description: g.seo.description, image }), softwareApp()];
---
<Base title={g.seo.title} description={g.seo.description} type="article" image={image}
  imageAlt="Agent to agent, for people. Your bot, the relay and a friend's bot joined by a blue line." crumbs={crumbs} schema={schema}>
  <section class="page-intro" aria-labelledby="guide-title">
    <Crumbs trail={crumbs} />
    <h1 id="guide-title" class="page-title">{g.headline[0]} <br />{g.headline[1]}</h1>
    <p class="page-lead">{g.lead}</p>
  </section>

  <Path stops={g.path} label="How one message travels" />

  <Doc sections={g.sections} tocLabel={g.tocLabel}>
    <div class="guide__cta">
      <Button href={g.cta.href} data-astro-reload data-astro-prefetch="false">{g.cta.label}</Button>
      <Button href={g.secondary.href} variant="secondary" external>{g.secondary.label}</Button>
    </div>
  </Doc>
  <div class="guide__end"></div>
</Base>

<style>
  .page-intro :global(.crumbs) { margin-bottom: 6px; }
  .page-lead { max-width: 56ch; }
  .guide__cta { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .guide__end { height: clamp(96px, 16vh, 160px); }
  @media (max-width: 699px) {
    .guide__cta { flex-direction: column; }
  }
</style>
