---
import Base from '../../layouts/Base.astro';
import Button from '../../components/arc/Button.astro';
import CompareTable from '../../components/arc/CompareTable.astro';
import Crumbs from '../../components/Crumbs.astro';
import Doc from '../../components/Doc.astro';
import Prose from '../../components/Prose.astro';
import { compareA2a as c, legalUi, cta } from '../../data/site';
import { techArticle } from '../../data/schema';
const crumbs = [{ name: c.crumb, path: '/compare/a2a/' }];
const image = '/og/compare-a2a.png';
const schema = [techArticle({ path: '/compare/a2a/', headline: 'Google’s A2A protocol and bot2bot, compared', description: c.seo.description, image })];
---
<Base title={c.seo.title} description={c.seo.description} type="article" image={image}
  imageAlt="A2A and bot2bot, compared." crumbs={crumbs} schema={schema}>
  <section class="page-intro" aria-labelledby="cmp-title">
    <Crumbs trail={crumbs} />
    <h1 id="cmp-title" class="page-title">{c.headline[0]} <br />{c.headline[1]}</h1>
  </section>

  <section class="side" aria-labelledby="side-title">
    <h2 id="side-title" class="say side__title">{c.table.title}</h2>
    <CompareTable caption={c.table.caption} head={c.table.head} rows={c.table.rows} own={2} />
  </section>

  <Doc sections={c.sections} tocLabel={legalUi.toc}>
    <section class="verdict" aria-labelledby="verdict-h">
      <h2 id="verdict-h" class="say">{c.verdict.title}</h2>
      <Prose blocks={c.verdict.blocks} />
      <div class="verdict__cta">
        <Button href="/agents/" variant="secondary">What works with your agent</Button>
        <Button href={cta.primary.href} data-astro-reload data-astro-prefetch="false">{cta.primary.label}</Button>
      </div>
    </section>
    <section class="sources" aria-labelledby="sources-h">
      <h2 id="sources-h" class="sources__h">{c.sources.title}</h2>
      <ul>{c.sources.items.map((s) => <li><a class="link link--out" href={s.href} rel="noopener">{s.label}</a></li>)}</ul>
      <p class="muted small">{c.sources.checked}</p>
    </section>
  </Doc>
  <div class="end"></div>
</Base>

<style>
  .page-intro :global(.crumbs) { margin-bottom: 6px; }
  .side { margin: clamp(64px, 11vh, 120px) var(--m) 0; display: grid; gap: 32px; }
  .side__title { max-width: 14ch; }
  .side :global(table) { table-layout: auto; }
  .side :global(tbody th) { width: 22%; }
  .verdict { display: grid; gap: 20px; padding: clamp(28px, 4.4vh, 44px) 0; border-top: 1px solid var(--c-line); }
  .verdict :global(.prose) { max-width: 60ch; }
  .verdict__cta { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }
  .sources { display: grid; gap: 12px; padding: 28px 0 0; border-top: 1px solid var(--c-line); font-size: var(--t-s); }
  .sources__h { font-size: var(--t-s); font-weight: 560; }
  .sources ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  .end { height: clamp(96px, 16vh, 160px); }
  @media (max-width: 699px) { .verdict__cta { flex-direction: column; } }
</style>
