---
import Base from '../layouts/Base.astro';
import SafetyCode from '../components/bencho/SafetyCode.astro';
import Bot from '../components/Bot.astro';
import Glyph from '../components/Glyph.astro';
import Figure from '../components/Figure.astro';
import { security as s, links } from '../data/site';
---
<Base title={s.seo.title} description={s.seo.description} crumbs={[{ name: 'Security', path: '/security/' }]}>
  <section class="page-intro" aria-labelledby="sec-title">
    <h1 id="sec-title" class="page-title">{s.headline[0]} <br />{s.headline[1]}</h1>
    <p class="page-lead">{s.lead}</p>
  </section>

  <!-- The path of one message. The wire is solid blue: sealed the whole way. -->
  <section class="path" aria-label="How a message travels">
    <ol class="path__list">
      {s.path.map((stop, i) => (
        <li class="path__stop">
          {i < 2 && <span class="path__wire" aria-hidden="true"><span class="path__signal" data-rail></span></span>}
          <div class="path__fig" aria-hidden="true">
            {i === 0 && <Bot state="you" size={44} />}
            {i === 1 && <Glyph kind="server" size={44} />}
            {i === 2 && <Bot state="lit" size={44} />}
          </div>
          <p class="path__who">{stop.who}</p>
          <p class="path__text">{stop.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sees" aria-labelledby="sees-title">
    <h2 id="sees-title" class="say sees__title">{s.seesTitle}</h2>
    {[s.sees.can, s.sees.cant].map((col, i) => (
      <div class:list={['sees__col', i === 1 && 'sees__col--sealed']}>
        <h3 class="sees__label">{col.label}</h3>
        <ul>{col.items.map((it) => <li>{it}</li>)}</ul>
      </div>
    ))}
    <p class="sees__note muted small">{s.seesNote}</p>
  </section>

  <section class="ledger" aria-label="Keys and checks">
    <article class="entry">
      <h2 class="say entry__title">{s.keys.title}</h2>
      <div class="entry__body">
        <p class="muted">{s.keys.text}</p>
        <p class="muted small entry__fine">{s.keys.curious}</p>
      </div>
    </article>
    <article class="entry">
      <h2 class="say entry__title">{s.code.title}</h2>
      <div class="entry__body">
        <p class="muted">{s.code.text}</p>
        <SafetyCode class="code" groups={s.code.example} label={s.code.exampleLabel} />
      </div>
    </article>
    <article class="entry">
      <h2 class="say entry__title">{s.hold.title}</h2>
      <div class="entry__body">
        <p class="muted">{s.hold.text}</p>
      </div>
    </article>
  </section>

  <!-- The honest exception. Dashed grey wire: not sealed. -->
  <section class="inbox" aria-labelledby="inbox-title">
    <Figure kind="quick" size={36} class="inbox__fig" />
    <h2 id="inbox-title" class="say inbox__title">{s.inbox.title}</h2>
    <div class="inbox__body">
      <p>{s.inbox.text}</p>
      <p class="muted small">{s.bot}</p>
    </div>
  </section>

  <section class="keep" aria-labelledby="keep-title">
    <h2 id="keep-title" class="keep__title">{s.keepTitle}</h2>
    <dl class="keep__list">
      {s.keep.map((k) => (
        <div class="keep__item">
          <dt class="keep__value">{k.value}</dt>
          <dd class="muted">{k.text}</dd>
        </div>
      ))}
    </dl>
    <ul class="rules">
      {s.rules.map((r) => <li>{r}</li>)}
    </ul>
    <p class="keep__links">
      <a class="link link--out" href={links.github} rel="noopener">{s.code_link}</a>
      <a class="link link--out" href={links.selfHost} rel="noopener">Self-hosting guide</a>
    </p>
  </section>
</Base>

<style>
  /* ---------- The path ---------- */
  .path { padding: clamp(64px, 11vh, 120px) var(--m) 0; }
  .path__list {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--gap);
  }
  .path__stop { position: relative; display: grid; align-content: start; gap: 10px; }
  /* Head centre of a 44 px bot: 37 px down. The wire runs head to head. */
  .path__wire {
    position: absolute; top: 37px; left: 64px; right: calc(-1 * var(--gap) + 12px);
    height: 1.5px; background: var(--c-line);
  }
  .path__signal { position: absolute; inset: 0; background: var(--c-signal); }
  .motion .path__signal { clip-path: inset(0% 100% 0% 0%); }
  .path__fig { height: 78px; display: flex; align-items: flex-start; }
  .path__who { font-weight: 560; font-size: var(--t-s); }
  .path__text { color: var(--c-muted); max-width: 26ch; }

  /* ---------- Can and can't see ---------- */
  .sees {
    margin: clamp(96px, 16vh, 168px) var(--m) 0; padding-top: 34px; border-top: 1px solid var(--c-line);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px var(--gap);
  }
  .sees__title { grid-column: 1 / span 5; max-width: 12ch; }
  .sees__col { grid-column: span 3; }
  .sees__col:nth-of-type(1) { grid-column: 7 / span 3; }
  .sees__label { font-size: var(--t-s); font-weight: 560; margin-bottom: 10px; }
  .sees__col ul { list-style: none; padding: 0; }
  .sees__col li { padding: 9px 0 9px 20px; border-top: 1px solid var(--c-line); position: relative; }
  .sees__col li::before {
    content: ''; position: absolute; left: 0; top: 50%; width: 8px; height: 8px; margin-top: -4px;
    border-radius: 50%; border: 1.2px solid var(--c-muted);
  }
  /* What is sealed: a closed light. */
  .sees__col--sealed li::before { border: 0; background: var(--c-ink); }
  .sees__note { grid-column: 7 / span 6; }

  /* ---------- Ledger: keys, codes, holds ---------- */
  .ledger { margin: clamp(96px, 16vh, 168px) var(--m) 0; }
  .entry {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px var(--gap);
    padding: clamp(28px, 4.4vh, 44px) 0; border-top: 1px solid var(--c-line);
  }
  .entry__title { grid-column: 1 / span 5; max-width: 13ch; }
  .entry__body { grid-column: 7 / span 6; display: grid; gap: 14px; max-width: 46ch; padding-top: 4px; }
  .entry__fine { font-size: var(--t-xs); }
  .code { display: grid; gap: 6px; margin-top: 8px; }
  .code__digits {
    display: flex; flex-wrap: wrap; gap: 0 0.5em;
    font-family: var(--f-display); font-weight: 460; font-size: var(--t-l); letter-spacing: -0.02em; line-height: 1.1;
  }
  .code__label { font-size: var(--t-xs); color: var(--c-muted); }

  /* ---------- Quick connect: the honest exception ---------- */
  .inbox {
    margin: clamp(56px, 9vh, 96px) var(--m) 0; padding: clamp(28px, 4vw, 48px);
    background: var(--c-tint); border-radius: calc(var(--r-button) + 6px);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px var(--gap);
  }
  .inbox__fig { grid-column: 1 / -1; }
  .inbox__title { grid-column: 1 / span 6; max-width: 16ch; }
  .inbox__body { grid-column: 7 / span 6; display: grid; gap: 14px; max-width: 46ch; padding-top: 4px; }

  /* ---------- What we keep ---------- */
  .keep { margin: clamp(96px, 16vh, 168px) var(--m) clamp(96px, 16vh, 160px); display: grid; gap: 30px; }
  .keep__title { font-size: var(--t-s); font-weight: 560; }
  .keep__list {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px var(--gap);
    padding-top: 26px; border-top: 1px solid var(--c-line);
  }
  .keep__item { display: grid; gap: 10px; align-content: start; }
  /* Mona, not Hubot: Hubot's zero is slashed, which reads as a code, not a duration.
     The slashed zero stays where it helps: the safety code. */
  .keep__value {
    font-family: var(--f-text); font-weight: 460; font-size: var(--t-xl);
    line-height: 0.9; letter-spacing: -0.055em; margin-left: -0.04em; white-space: nowrap;
  }
  .keep__item dd { max-width: 26ch; }
  .rules { list-style: none; padding: 26px 0 0; border-top: 1px solid var(--c-line); display: grid; gap: 6px; margin-top: 18px; }
  .rules li { padding-left: 18px; position: relative; }
  .rules li::before {
    content: ''; position: absolute; left: 0; top: 0.7em; width: 6px; height: 6px; border-radius: 50%; background: var(--c-ink);
  }
  .keep__links { display: flex; flex-wrap: wrap; gap: 10px 26px; font-size: var(--t-s); }

  @media (max-width: 899px) {
    .sees__title { grid-column: 1 / -1; max-width: none; }
    .sees__col:nth-of-type(1), .sees__col { grid-column: span 6; }
    .sees__note { grid-column: 1 / -1; }
    .entry__title { grid-column: 1 / -1; max-width: none; }
    .entry__body { grid-column: 1 / -1; }
    .inbox__title, .inbox__body { grid-column: 1 / -1; }
    .keep__value { font-size: var(--t-l); }
  }
  @media (max-width: 699px) {
    .path__list { grid-template-columns: 1fr; gap: 0; }
    .path__stop {
      grid-template-columns: 56px 1fr; column-gap: 16px; row-gap: 4px; padding: 0 0 34px;
    }
    .path__fig { grid-row: span 2; height: auto; }
    .path__fig :global(svg) { width: 40px; height: auto; }
    /* The wire turns vertical: down from one head to the next. */
    .path__wire { top: 48px; bottom: -4px; left: 20px; right: auto; width: 1.5px; height: auto; }
    .motion .path__signal { clip-path: inset(0% 0% 100% 0%); }
    .sees, .entry, .inbox { grid-template-columns: 1fr; }
    .sees__col:nth-of-type(1), .sees__col, .sees__note { grid-column: 1; }
    .keep__list { grid-template-columns: 1fr; gap: 24px; }
    .keep__item { grid-template-columns: 8.25rem 1fr; align-items: baseline; gap: 14px; }
    .keep__value { font-size: 2.125rem; }
  }
</style>
