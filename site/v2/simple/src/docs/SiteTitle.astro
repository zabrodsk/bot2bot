---
// Docs header title: the bot mark, the name and a quiet "Docs" tag. It leads to the docs home, not the site home.
import { Image } from 'astro:assets';
import light from './mark.svg';
import dark from './mark-dark.svg';
---
<a href="/docs/" class="dt">
  <Image src={light} alt="" class="dt__mark light:sl-block dark:sl-hidden" width={19} height={20} />
  <Image src={dark} alt="" class="dt__mark light:sl-hidden dark:sl-block" width={19} height={20} />
  <span class="dt__name">bot2bot</span><span class="dt__tag">Docs</span>
</a>

<style>
  .dt { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--sl-color-white); white-space: nowrap; }
  .dt__mark { width: 19px; height: 20px; }
  .dt__name { font-family: var(--docs-display); font-weight: 560; font-size: 1.125rem; letter-spacing: -0.02em; }
  .dt__tag {
    font-size: 0.75rem; font-weight: 540; color: var(--sl-color-gray-3);
    padding: 0.125rem 0.5rem; border-radius: 9999px; box-shadow: inset 0 0 0 1px var(--sl-color-hairline);
  }
</style>
