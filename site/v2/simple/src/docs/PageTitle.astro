---
// The page title, then three ways to hand the page to an AI: copy it as Markdown, open the Markdown,
// or ask Grok about it. Copy follows Arc's copy button: the label swaps to "Copied" and a status is announced.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { mdPath, htmlPath } from './markdown';
import { site } from '../data/site';

const id = Astro.locals.starlightRoute.entry.id;
const md = mdPath(id);
const ask = `https://grok.com/?q=${encodeURIComponent(`Read ${site.url}${md} (bot2bot docs) and help me with it.`)}`;
---
<Default />
<div class="pa" data-page-actions>
  <button type="button" class="pa__btn" data-copy-page={md} data-state="idle">
    <svg class="is-idle" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
    <svg class="is-done" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
    <span class="is-idle">Copy page</span><span class="is-done">Copied</span>
  </button>
  <a class="pa__btn" href={md} type="text/markdown">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" /><path d="M9 13h6M9 17h4" /></svg>
    Markdown
  </a>
  <a class="pa__btn" href={ask} target="_blank" rel="noopener">
    Ask Grok
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
  </a>
  <span class="sr-only" role="status" aria-live="polite" data-copy-page-status></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-page]').forEach((btn) => {
    const status = btn.parentElement?.querySelector('[data-copy-page-status]');
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        const text = await fetch(btn.dataset.copyPage!).then((r) => { if (!r.ok) throw new Error(); return r.text(); });
        await navigator.clipboard.writeText(text);
        btn.dataset.state = 'done';
        if (status) status.textContent = 'Page copied as Markdown';
        clearTimeout(timer);
        timer = window.setTimeout(() => { btn.dataset.state = 'idle'; if (status) status.textContent = ''; }, 1800);
      } catch {
        if (status) status.textContent = 'Could not copy. Open the Markdown instead.';
      }
    });
  });
</script>

<style>
  .pa { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
  .pa__btn {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 2rem; padding: 0 0.75rem;
    border-radius: 9999px; border: 1px solid var(--sl-color-hairline-light); background: var(--sl-color-black);
    color: var(--sl-color-gray-2); font: inherit; font-size: 0.8125rem; font-weight: 540; text-decoration: none; cursor: pointer;
    transition: color 160ms cubic-bezier(0.22, 1, 0.36, 1), border-color 160ms cubic-bezier(0.22, 1, 0.36, 1), transform 120ms;
  }
  .pa__btn:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  .pa__btn:active { transform: scale(0.97); }
  .pa__btn:focus:not(:focus-visible) { outline: none; }
  .pa__btn .is-done { display: none; }
  .pa__btn[data-state='done'] .is-idle { display: none; }
  .pa__btn[data-state='done'] .is-done { display: inline; }
  .pa__btn[data-state='done'] { color: var(--sl-color-green); }
  :global(:root:not([data-theme='light'])) .pa__btn[data-state='done'] { color: var(--sl-color-green-high); border-color: color-mix(in srgb, var(--sl-color-green-high) 40%, transparent); }
  @media (prefers-reduced-motion: reduce) { .pa__btn { transition: none; } .pa__btn:active { transform: none; } }
</style>
