---
// The field of sleeping bots. Built on the client (it depends on the viewport) by
// src/motion/field.ts. Decorative: everything it says is also in the page text.
interface Props { mode?: 'wake' | 'miss'; names?: string[]; you?: string; class?: string }
const { mode = 'wake', names = [], you = 'You', class: cls } = Astro.props;
---
<div class:list={['field', cls]} data-field={mode} data-names={JSON.stringify(names)} data-you={you} aria-hidden="true">
  <svg class="field__svg" xmlns="http://www.w3.org/2000/svg" focusable="false"></svg>
</div>

<style>
  .field { position: relative; min-height: 0; }
  .field__svg { position: absolute; left: 0; top: 0; overflow: visible; }
  :global(html.js) .field { opacity: 0; transition: opacity 0.9s var(--ease-settle); }
  :global(html.js) .field.is-built { opacity: 1; }
  :global(html:not(.js)) .field {
    background: url('/bot-tile.svg') 0 100% / 30px 30px repeat;
  }
</style>
