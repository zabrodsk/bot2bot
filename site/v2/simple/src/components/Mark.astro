---
// The identity mark: your bot (solid head, white eyes, blue light).
interface Props { size?: number; class?: string }
const { size = 20, class: cls } = Astro.props;
---
<svg class:list={['mark', cls]} width={size} height={size * 1.05} viewBox="-9.5 -13.2 19 20" aria-hidden="true">
  <line x1="0" y1="-6" x2="0" y2="-8.9" stroke="#1a2230" stroke-width="1.6" stroke-linecap="round" />
  <circle cx="0" cy="-10.6" r="2" fill="#2747c9" />
  <rect x="-8.5" y="-6.2" width="17" height="13" rx="4.2" fill="#1a2230" />
  <rect x="-4.7" y="-1.9" width="2.8" height="3.6" rx="1.2" fill="#fff" />
  <rect x="1.9" y="-1.9" width="2.8" height="3.6" rx="1.2" fill="#fff" />
</svg>
