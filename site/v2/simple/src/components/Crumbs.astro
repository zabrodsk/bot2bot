---
// A visible breadcrumb that matches the BreadcrumbList in the page's structured data.
interface Props { trail: { name: string; path: string }[] }
const { trail } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {trail.map((c, i) => (
      <li>{i === trail.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 0; font-size: var(--t-xs); color: var(--c-muted); }
  .crumbs li + li::before { content: '/'; margin: 0 9px; color: var(--c-sleep); }
  .crumbs a { padding: 6px 0; transition: color 0.25s var(--ease-open); }
  .crumbs a:hover { color: var(--c-ink); }
  .crumbs [aria-current] { color: var(--c-ink); }
</style>
