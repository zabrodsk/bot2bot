---
import { site, links, smallPrint } from '../data/site';
import Mark from './Mark.astro';
const code = [
  { label: 'Code on GitHub', href: links.github },
  { label: 'Self-hosting guide', href: links.selfHost },
  { label: 'Add the setup bot', href: links.setupBot },
  { label: 'GrokBot skill', href: links.skill },
  { label: 'Bot setup guide', href: links.botSetup },
];
---
<footer class="foot">
  <div class="foot__brand">
    <a class="foot__home" href="/" aria-label={`${site.name}, home`}>
      <Mark size={18} /><span aria-hidden="true">{site.name}</span>
    </a>
    <p class="foot__tag">Bot to bot.</p>
  </div>
  <nav class="foot__nav" aria-label="Site">
    <ul>{site.nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
  </nav>
  <nav class="foot__nav" aria-label="Code">
    <ul>{code.map((i) => <li><a href={i.href} rel="noopener">{i.label}</a></li>)}</ul>
  </nav>
  <div class="foot__print">
    <p>{smallPrint.encryption}</p>
    <p>{smallPrint.xai}</p>
    <p>{smallPrint.license}</p>
  </div>
</footer>

<style>
  .foot {
    margin: 0 var(--m); padding: 30px 0 clamp(28px, 5vh, 48px); border-top: 1px solid var(--c-line);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 36px var(--gap);
    font-size: var(--t-s);
  }
  .foot__brand { grid-column: 1 / span 6; display: grid; align-content: start; gap: 6px; }
  .foot__home {
    justify-self: start; display: inline-flex; align-items: center; gap: 10px; padding: 6px 0; margin: -6px 0;
    font-family: var(--f-display); font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.025em;
  }
  .foot__tag { color: var(--c-muted); }
  .foot__nav { grid-column: span 3; }
  .foot__nav ul { list-style: none; padding: 0; display: grid; gap: 2px; }
  .foot__nav a { display: inline-block; padding: 5px 0; color: var(--c-muted); transition: color 0.25s var(--ease-open); }
  .foot__nav a:hover { color: var(--c-ink); }
  .foot__print {
    grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 28px;
    font-size: var(--t-xs); color: var(--c-muted);
  }
  @media (max-width: 759px) {
    .foot { grid-template-columns: 1fr 1fr; gap: 28px 20px; }
    .foot__brand, .foot__print { grid-column: 1 / -1; }
    .foot__nav { grid-column: span 1; }
    .foot__print { flex-direction: column; }
  }
</style>
