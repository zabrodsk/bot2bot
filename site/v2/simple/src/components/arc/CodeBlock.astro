---
// Arc UI Code block + Copy button (https://uiarc.dev/components/code-block), ported to Astro. MIT, see ./LICENSE.md.
// The copy behaviour lives in the page scripts: they set data-state on [data-copy] and fill the status line.
interface Props {
  lines: string[];
  filename: string;
  language?: string;
  commands?: boolean;
  id: string;
}
const { lines, filename, language = 'shell', commands = true, id } = Astro.props;
const text = lines.join('\n');
---
<section class="arc-code" aria-labelledby={id}>
  <header class="arc-code__header">
    <div class="arc-code__file">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 17 6-6-6-6" /><path d="M12 19h8" /></svg>
      <span id={id}>{filename}</span>
      <span class="arc-code__lang">{language}</span>
    </div>
    <button class="arc-copy" type="button" data-copy={text} data-state="idle" aria-describedby={id}>
      <span class="arc-copy__icon" aria-hidden="true">
        <svg class="is-idle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
        <svg class="is-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
      </span>
      <span class="arc-copy__label"><span aria-hidden="true">Copied</span><span data-copy-label>Copy</span></span>
    </button>
    <span class="arc-sr" role="status" aria-live="polite" data-copy-status></span>
  </header>
  <pre class="arc-code__pre" tabindex="0" aria-label="Selectable source code"><code>{lines.map((line) => <span class:list={['arc-code__line', commands && 'arc-code__line--cmd']}>{line}</span>)}</code></pre>
</section>
