---
// Arc UI Button (https://uiarc.dev/components/button), ported to Astro. MIT, see ./LICENSE.md.
// Renders a link when given an href; external links get Arc's up-right arrow.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  external?: boolean;
  wide?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'lg', external = false, wide = false, class: className, ...rest } = Astro.props;
const classes = ['arc-button', `arc-button--${variant}`, size === 'md' && 'arc-button--md', wide && 'arc-button--wide', className];
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={classes}
  href={href}
  type={href ? undefined : 'button'}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <slot />
  {external && (
    <svg class="arc-button__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
  )}
</Tag>
