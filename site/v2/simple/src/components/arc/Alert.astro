---
// Arc UI Alert (https://uiarc.dev/components/alert), ported to Astro. MIT, see ./LICENSE.md.
// Static page notes use role="note" rather than Arc's live status role, so nothing is announced on load.
interface Props {
  title?: string;
  tone?: 'info' | 'neutral';
  class?: string;
}
const { title, tone = 'info', class: className } = Astro.props;
const hasAction = Astro.slots.has('action');
const hasIcon = Astro.slots.has('icon');
---
<div class:list={['arc-alert', `arc-alert--${tone}`, hasAction && 'arc-alert--action', className]} role="note">
  <span class="arc-alert__icon" aria-hidden="true">
    {hasIcon ? <slot name="icon" /> : (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
    )}
  </span>
  <div class="arc-alert__copy">
    {title && <p class="arc-alert__title">{title}</p>}
    {Astro.slots.has('default') && <p class="arc-alert__description"><slot /></p>}
  </div>
  {hasAction && <div class="arc-alert__action"><slot name="action" /></div>}
</div>
