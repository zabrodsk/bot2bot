---
// Arc UI Accordion (https://uiarc.dev/components/accordion), "lg" size, ported to Astro. MIT, see ./LICENSE.md.
// Native <details name> keeps one item open at a time and works without JS; answers stay in the
// page for find-in-page and crawlers. Height follows the content where the browser can animate
// ::details-content, and the answer settles down from a brief blur, like Arc's.
import Rich from '../Rich.astro';
interface Props { group: string; items: { q: string; a: string[] }[] }
const { group, items } = Astro.props;
---
<div class="arc-acc">
  {items.map((item) => (
    <details class="arc-acc__item" name={group}>
      <summary class="arc-acc__trigger">
        <h3 class="arc-acc__q">{item.q}</h3>
        <svg class="arc-acc__icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <div class="arc-acc__panel">
        {item.a.map((p) => <p><Rich text={p} /></p>)}
      </div>
    </details>
  ))}
</div>

<style>
  .arc-acc { width: 100%; border-top: 1px solid var(--border); interpolate-size: allow-keywords; }
  .arc-acc__item { border-bottom: 1px solid var(--border); }
  .arc-acc__trigger {
    display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: var(--space-5);
    padding-block: var(--space-5); list-style: none; cursor: pointer; -webkit-tap-highlight-color: transparent;
    color: var(--foreground); transition: color var(--duration-fast) var(--ease-standard);
  }
  .arc-acc__trigger::-webkit-details-marker { display: none; }
  .arc-acc__trigger:focus-visible { outline-offset: 4px; }
  .arc-acc__q { font-size: var(--t-m); font-weight: 480; letter-spacing: -0.015em; line-height: 1.3; }
  .arc-acc__icon {
    flex: none; color: var(--text-muted);
    transition: rotate var(--duration-spring) var(--ease-spring), color var(--duration-fast) var(--ease-standard);
  }
  .arc-acc__item[open] .arc-acc__icon { rotate: 180deg; color: var(--foreground); }
  @media (hover: hover) and (pointer: fine) {
    .arc-acc__trigger:hover { color: var(--text-secondary); }
    .arc-acc__trigger:hover .arc-acc__icon { color: var(--foreground); }
  }
  .arc-acc__panel { display: grid; gap: 12px; max-width: 62ch; padding: 0 var(--space-5) var(--space-5) 0; color: var(--text-secondary); line-height: 1.6; }
  .arc-acc__panel :global(.link) { color: var(--c-ink); }

  /* Height on a spring that never overshoots, where supported. Elsewhere it simply opens. */
  .arc-acc__item::details-content {
    block-size: 0; overflow: clip;
    transition: block-size 0.42s var(--ease-standard), content-visibility 0.42s allow-discrete;
  }
  .arc-acc__item[open]::details-content { block-size: auto; }
  .arc-acc__panel { translate: 0 -6px; filter: blur(2px); opacity: 0.4; transition: translate 0.42s var(--ease-standard), filter 0.24s var(--ease-open), opacity 0.24s var(--ease-open); }
  .arc-acc__item[open] .arc-acc__panel { translate: 0 0; filter: none; opacity: 1; }

  @media (max-width: 520px) {
    .arc-acc__trigger { min-height: 68px; }
    .arc-acc__q { font-size: 1.125rem; }
    .arc-acc__panel { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .arc-acc__trigger, .arc-acc__icon, .arc-acc__item::details-content, .arc-acc__panel { transition: none; }
    .arc-acc__panel { translate: none; filter: none; opacity: 1; }
  }
</style>
