---
// A message that tries to give orders, and what your bot does with it: it tells you, and does nothing else.
interface Props { inFrom: string; inText: string; outFrom: string; outText: string }
const p = Astro.props;
---
<div class="nd" role="group" aria-label="Example">
  <p class="nd__who">{p.inFrom}</p>
  <p class="nd__msg nd__msg--in">{p.inText}</p>
  <p class="nd__who nd__who--out">{p.outFrom}</p>
  <p class="nd__msg nd__msg--out">{p.outText}</p>
</div>

<style>
  .nd { display: grid; gap: 8px; justify-items: start; max-width: 360px; color: var(--foreground); }
  .nd__who { padding-left: 4px; font-size: 0.75rem; font-weight: 520; }
  .nd__who--out { margin-top: 10px; justify-self: end; padding: 0 4px 0 0; }
  .nd__msg { padding: 11px 18px; font-size: 1rem; line-height: 22px; letter-spacing: -0.01em; }
  /* Their words: kept at arm's length, struck through as an order. */
  .nd__msg--in {
    border-radius: 20px 20px 20px 6px; background: var(--surface); box-shadow: 0 0 0 1px var(--border);
    color: var(--text-secondary); text-decoration: line-through; text-decoration-color: color-mix(in oklab, var(--text-secondary) 55%, transparent);
    text-decoration-thickness: 1px;
  }
  /* Your bot, talking to you: the ink of the "you" bot. */
  .nd__msg--out { justify-self: end; border-radius: 20px 20px 6px 20px; background: var(--foreground); color: var(--surface); }
</style>
