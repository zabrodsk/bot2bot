---
// One fact on the home page: a figure, a title, the text, an optional link, and a demo in the slot.
import Figure from '../Figure.astro';
interface Props { fig: Parameters<typeof Figure>[0]['kind']; title: string; text: string; link?: { label: string; href: string } }
const { fig, title, text, link } = Astro.props;
const out = link?.href.startsWith('http');
---
<article class="row">
  <div class="row__fig"><Figure kind={fig} size={30} /></div>
  <h2 class="row__title say">{title}</h2>
  <div class="row__body">
    <p class="muted">{text}</p>
    {link && <p><a class:list={['link', out && 'link--out']} href={link.href} rel={out ? 'noopener' : undefined}>{link.label}</a></p>}
    <slot />
  </div>
</article>

<style>
  .row {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px var(--gap);
    padding: clamp(28px, 4.4vh, 44px) 0; border-top: 1px solid var(--c-line);
    align-items: start;
  }
  .row:last-child { border-bottom: 1px solid var(--c-line); }
  .row__fig { grid-column: 1 / span 3; padding-top: 2px; }
  .row__title { grid-column: 4 / span 5; max-width: 14ch; }
  .row__body { grid-column: 9 / span 4; display: grid; gap: 12px; max-width: 36ch; padding-top: 4px; }
  .row__body > :global(:nth-child(n + 2):not(p)) { margin-top: 8px; }

  @media (max-width: 1023px) {
    .row__fig { grid-column: 1 / -1; }
    .row__title { grid-column: 1 / span 6; }
    .row__body { grid-column: 7 / span 6; }
  }
  @media (max-width: 699px) {
    .row { grid-template-columns: 1fr; gap: 16px; }
    .row__fig, .row__title, .row__body { grid-column: 1; }
    .row__fig { padding-bottom: 6px; }
  }
</style>
