---
// One night, scrolled through. The stage pins and the scroll is the clock: blue hour, then night
// over the field of sleeping bots, then morning. Friends' bots send; each message runs the gutters
// to your bot, hits the quiet ring around it and waits in line. At 08:00 the ring opens, the line
// pours in, your bot wakes and tells you. motion/quiet.ts drives all of it from one timeline.
// Without JS or with reduced motion this is a still: late in the night, three messages waiting.
import { BOT } from '../../data/bot';
interface Message { at: string; from: string; text: string }
interface Props {
  title: string; label: string; hours: string; over: string;
  doorbellOff: string; doorbellOn: string; you: string; waiting: string;
  messages: Message[]; morning: { from: string; text: string }; still: string;
}
const p = Astro.props;

// Stars, the same on every build. x/y in percent of the sky; three groups twinkle out of step.
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 90 }, (_, i) => ({
  x: (rand() * 100).toFixed(2), y: (rand() * 62).toFixed(2), r: (rand() < 0.12 ? 1.6 : 0.6 + rand() * 0.7).toFixed(2), g: i % 3,
}));
const h = BOT.head, l = BOT.light;
const asleepH = BOT.eyes[0].h * BOT.asleepEye;
---
<div class="qs" data-qs aria-label={p.label} role="group">
  <div class="qs__sky qs__sky--night" aria-hidden="true"></div>
  <div class="qs__sky qs__sky--dusk" aria-hidden="true"></div>
  <div class="qs__sky qs__sky--morning" aria-hidden="true"></div>

  <svg class="qs__stars" aria-hidden="true" preserveAspectRatio="none">
    {[0, 1, 2].map((g) => (
      <g class={`qs__twinkle qs__twinkle--${g}`}>
        {stars.filter((s) => s.g === g).map((s) => <circle cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} />)}
      </g>
    ))}
    <line class="qs__shoot" x1="0" y1="0" x2="-120" y2="-34" />
  </svg>

  <div class="qs__dawn" aria-hidden="true"></div>
  <svg class="qs__moon" viewBox="0 0 64 64" aria-hidden="true">
    <defs><mask id="qs-moon-cut"><rect width="64" height="64" fill="#fff" /><circle cx="44" cy="20" r="22" fill="#000" /></mask></defs>
    <circle cx="30" cy="34" r="26" fill="currentColor" mask="url(#qs-moon-cut)" />
  </svg>
  <svg class="qs__sun" viewBox="-60 -60 120 120" aria-hidden="true">
    <circle r="22" fill="currentColor" />
    {Array.from({ length: 12 }, (_, i) => {
      const a = (i * Math.PI) / 6, c = Math.cos(a), s = Math.sin(a);
      return <line x1={(c * 32).toFixed(2)} y1={(s * 32).toFixed(2)} x2={(c * 44).toFixed(2)} y2={(s * 44).toFixed(2)} />;
    })}
  </svg>

  <div class="qs__ground" aria-hidden="true"></div>
  <svg class="qs__field" aria-hidden="true"></svg>

  <div class="qs__copy">
    <h2 id="quiet-title" class="qs__title say">{p.title}</h2>
  </div>

  <div class="qs__clock">
    <p class="qs__time" aria-hidden="true"><span data-qs-time>07:10</span></p>
    <p class="qs__hours">
      <span class="qs__swap" data-qs-hours>{p.hours}</span>
      <span class="qs__swap qs__swap--morning" data-qs-over aria-hidden="true">{p.over}</span>
    </p>
  </div>

  <div class="qs__dock">
    <div class="qs__you" data-qs-you>
      <svg class="qs__ring" viewBox="-100 -100 200 200" aria-hidden="true">
        <circle class="qs__ringline" r="96" pathLength="100" />
        <circle class="qs__ringpulse" r="96" />
      </svg>
      <svg class="qs__bot" viewBox={`${h.x - 2} ${BOT.top - 2} ${h.w + 4} ${BOT.bottom - BOT.top + 4}`} aria-hidden="true">
        <circle class="qs__botping" cx="0" cy={l.cy} r={l.r} />
        <line class="qs__botant" x1="0" y1={BOT.antenna.y1} x2="0" y2={BOT.antenna.y2} />
        <circle class="qs__botlight" cx="0" cy={l.cy} r={l.r} />
        <rect class="qs__bothead" x={h.x} y={h.y} width={h.w} height={h.h} rx={h.rx} />
        {BOT.eyes.map((e) => <rect class="qs__boteye" x={e.x} y={BOT.eyeCy - asleepH / 2} width={e.w} height={asleepH} rx={asleepH / 2} data-open-y={e.y} data-open-h={e.h} data-open-rx={e.rx} />)}
      </svg>
      <span class="qs__zz" aria-hidden="true"><span>z</span><span>z</span><span>z</span></span>
      <p class="qs__name">{p.you}</p>
      <p class="qs__bell">
        <span class="qs__swap" data-qs-off>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.7 3A6 6 0 0 1 18 8a21.3 21.3 0 0 0 .6 5" /><path d="M17 17H3s3-2 3-9a4.67 4.67 0 0 1 .3-1.7" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /><path d="m2 2 20 20" /></svg>
          {p.doorbellOff}
        </span>
        <span class="qs__swap qs__swap--morning" data-qs-on aria-hidden="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
          {p.doorbellOn}
        </span>
      </p>
      <div class="qs__bubble" data-qs-bubble>
        <p class="qs__bubblewho">{p.morning.from}</p>
        <p class="qs__bubbletext">{p.morning.text}</p>
      </div>
    </div>

    <ol class="qs__queue" data-qs-queue>
      {p.messages.map((m) => (
        <li class="qs__msg">
          <span class="qs__msghead">{m.from} <time>{m.at}</time></span>
          <span class="qs__msgtext">{m.text}</span>
          <span class="qs__msgwait">{p.waiting}</span>
        </li>
      ))}
    </ol>
  </div>

  <p class="qs__foot">
    <span class="qs__still">{p.still}</span>
  </p>
</div>

<style>
  .qs {
    --qs-fg: #e7ecf3; --qs-muted: #9aa6bb; --qs-line: rgb(231 236 243 / 0.22); --qs-card: rgb(18 26 43 / 0.72);
    --night: #0b1120;
    position: relative; height: 100svh; min-height: 680px; max-height: 1100px; overflow: hidden; isolation: isolate;
    color: var(--qs-fg); background: var(--night);
  }
  .qs > * { position: absolute; }

  /* The sky: night underneath, the blue hour and the morning laid over it. */
  .qs__sky { inset: 0; z-index: -3; }
  .qs__sky--night { background: radial-gradient(120% 70% at 70% 0%, #17213a 0%, #0b1120 55%, #070b14 100%); }
  .qs__sky--dusk { background: linear-gradient(180deg, #121a2b 0%, #1c2a63 52%, #2747c9 100%); opacity: 0; }
  .qs__sky--morning { background: linear-gradient(180deg, #f3f5f8 0%, #edf1f8 55%, #dce4f6 100%); opacity: 0; }

  .qs__stars { inset: 0; z-index: -2; width: 100%; height: 100%; overflow: visible; }
  .qs__stars circle { fill: #e7ecf3; }
  .qs__twinkle--1 { opacity: 0.7; }
  .qs__twinkle--2 { opacity: 0.45; }
  .qs__shoot { stroke: #e7ecf3; stroke-width: 1.4; stroke-linecap: round; opacity: 0; }

  .qs__moon { z-index: -2; left: 0; top: 0; width: clamp(54px, 6vw, 92px); color: #f4eedb; filter: drop-shadow(0 0 28px rgb(244 238 219 / 0.35)); translate: 44vw 36vh; }
  /* The sun comes up behind the ground, at the horizon (--hz, set by the driver). */
  .qs__sun { --sz: clamp(170px, 18vw, 270px); z-index: -2; left: 30%; top: calc(var(--hz, 55%) - var(--sz) * 0.56); width: var(--sz); margin-left: calc(var(--sz) / -2); color: var(--c-signal); opacity: 0; }
  .qs__dawn {
    z-index: -2; left: 0; right: 0; top: calc(var(--hz, 55%) - 60vh); height: 60vh; opacity: 0;
    background: radial-gradient(55% 100% at 30% 100%, rgb(255 255 255 / 0.95) 0%, rgb(205 216 250 / 0.7) 30%, rgb(39 71 201 / 0.25) 55%, transparent 75%);
  }
  .qs__ground { z-index: -1; left: 0; right: 0; top: var(--hz, 55%); bottom: 0; --g: 0; }
  .qs__ground::before, .qs__ground::after { content: ''; position: absolute; inset: 0; }
  .qs__ground::before { background: linear-gradient(180deg, #16204a 0%, #0c1224 18%, #070b14 100%); box-shadow: 0 -1px 0 rgb(231 236 243 / 0.08); }
  .qs__ground::after { background: linear-gradient(180deg, #e3e9f6 0%, #f3f5f8 100%); box-shadow: 0 -1px 0 rgb(26 34 48 / 0.08); opacity: var(--g); }
  .qs__sun line { stroke: currentColor; stroke-width: 3.2; stroke-linecap: round; }
  .qs__sun { filter: drop-shadow(0 0 30px rgb(39 71 201 / 0.35)); }

  .qs__field { inset: 0; z-index: -1; width: 100%; height: 100%; color: rgb(231 236 243 / 0.16); }

  /* Words. Everything that sits on the sky follows --qs-fg, which flips at dawn. */
  .qs__copy { left: var(--m); top: clamp(48px, 9vh, 96px); width: min(34rem, 44vw); display: grid; gap: 18px; }
  .qs__title { color: var(--qs-fg); max-width: 13ch; }
  .qs__clock { right: var(--m); top: clamp(36px, 7vh, 80px); text-align: right; }
  .qs__time {
    font-family: var(--f-display); font-weight: 440; font-size: clamp(5.5rem, 2rem + 13vw, 15.5rem);
    line-height: 0.82; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; margin-right: -0.04em;
  }
  .qs__hours { position: relative; margin-top: 14px; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 0.8125rem; color: var(--qs-muted); }
  .qs__swap { display: inline-flex; align-items: center; gap: 8px; }
  .qs__swap--morning { position: absolute; right: 0; top: 0; white-space: nowrap; opacity: 0; }

  /* Your bot, the quiet ring around it, and the line of messages waiting outside. */
  .qs__dock { right: calc(var(--m) + 4vw); bottom: clamp(70px, 13vh, 130px); display: flex; align-items: center; gap: clamp(28px, 4vw, 64px); }
  .qs__you { position: relative; width: clamp(170px, 15vw, 220px); aspect-ratio: 1; display: grid; place-items: center; }
  .qs__ring { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .qs__ringline { fill: rgb(11 17 32 / 0.55); stroke: var(--qs-fg); stroke-width: 1.4; stroke-dasharray: 1.2 1.6; stroke-linecap: round; opacity: 0.75; }
  .qs__ringpulse { fill: none; stroke: var(--c-signal); stroke-width: 2.5; opacity: 0; transform-origin: center; }
  .qs__bot { position: relative; width: 44%; overflow: visible; }
  .qs__bothead { fill: #1b2540; stroke: #e7ecf3; stroke-width: 0.9; }
  .qs__boteye { fill: #e7ecf3; }
  .qs__botant { stroke: #e7ecf3; stroke-width: 0.9; stroke-linecap: round; }
  .qs__botlight { fill: #3a4660; }
  .qs__botping { fill: none; stroke: var(--c-signal); stroke-width: 0.6; opacity: 0; }
  .qs__name { position: absolute; top: calc(100% + 14px); left: 50%; translate: -50% 0; font-size: var(--t-xs); font-weight: 520; white-space: nowrap; }
  .qs__bell { position: absolute; top: calc(100% + 36px); left: 50%; translate: -50% 0; font-size: 0.75rem; color: var(--qs-muted); white-space: nowrap; }
  .qs__bell .qs__swap--morning { left: 50%; right: auto; translate: -50% 0; color: var(--c-signal); }
  .qs__bell svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .qs__zz { position: absolute; left: 62%; top: 14%; width: 40px; height: 50px; font-family: var(--f-display); font-weight: 500; color: var(--qs-fg); pointer-events: none; }
  .qs__zz span { position: absolute; left: 0; bottom: 0; font-size: 13px; line-height: 1; opacity: 0.85; }
  .qs__zz span:nth-child(2) { left: 9px; bottom: 15px; font-size: 17px; }
  .qs__zz span:nth-child(3) { left: 20px; bottom: 33px; font-size: 22px; }

  .qs__bubble {
    position: absolute; bottom: calc(100% + 6px); right: 30%; width: max-content; max-width: min(320px, 70vw);
    display: grid; justify-items: end; gap: 6px; opacity: 0; pointer-events: none;
  }
  .qs__bubblewho { font-size: 0.75rem; font-weight: 520; padding-right: 4px; }
  .qs__bubbletext {
    padding: 12px 18px; border-radius: 20px 20px 6px 20px; background: var(--c-ink); color: var(--c-white);
    font-size: 1rem; line-height: 22px; letter-spacing: -0.01em; box-shadow: 0 18px 40px -18px rgb(18 26 43 / 0.5);
  }

  .qs__queue { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; width: clamp(230px, 19vw, 280px); }
  .qs__msg {
    display: grid; gap: 2px; padding: 11px 14px 12px; border-radius: 14px;
    background: var(--qs-card); box-shadow: inset 0 0 0 1px var(--qs-line), 0 14px 30px -18px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .qs__msghead { display: flex; justify-content: space-between; gap: 10px; font-size: 0.75rem; font-weight: 540; }
  .qs__msghead time, .qs__msgwait { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; font-weight: 450; }
  .qs__msghead time { font-size: 0.6875rem; color: var(--qs-muted); }
  .qs__msgtext { font-size: 0.9375rem; line-height: 1.3; letter-spacing: -0.01em; }
  .qs__msgwait { margin-top: 4px; font-size: 0.6875rem; color: var(--qs-muted); }

  .qs__foot { left: var(--m); bottom: clamp(22px, 4vh, 40px); max-width: 44ch; font-size: var(--t-xs); color: var(--qs-muted); }

  /* Ambient night life. Off for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .qs__twinkle--0 { animation: qs-twinkle 4.2s ease-in-out infinite; }
    .qs__twinkle--1 { animation: qs-twinkle 5.6s ease-in-out 1.4s infinite; }
    .qs__twinkle--2 { animation: qs-twinkle 3.4s ease-in-out 0.7s infinite; }
    .qs__zz span { animation: qs-zz 3s ease-in-out infinite; }
    .qs__zz span:nth-child(2) { animation-delay: 0.5s; }
    .qs__zz span:nth-child(3) { animation-delay: 1s; }
  }
  @keyframes qs-twinkle { 0%, 100% { opacity: 0.85; } 50% { opacity: 0.25; } }
  @keyframes qs-zz { 0%, 100% { translate: 0 0; opacity: 0.85; } 50% { translate: 3px -5px; opacity: 0.3; } }

  /* When the night is played (JS, motion allowed) the still's extra line goes; the run says it. */
  :global(html.motion) .qs[data-live] .qs__still { display: none; }

  /* Phones and small tablets: words on top, the clock under them, your bot bottom right with its
     line of messages stacked above it, compact. */
  @media (max-width: 899px) {
    .qs { min-height: 700px; max-height: none; }
    .qs__copy { width: auto; right: var(--m); top: 36px; gap: 10px; }
    .qs__clock { left: var(--m); right: auto; top: clamp(196px, 29vh, 300px); text-align: left; }
    .qs__time { font-size: clamp(4.25rem, 21vw, 8rem); }
    .qs__hours { margin-top: 10px; }
    .qs__swap--morning { left: 0; right: auto; }
    .qs__moon { width: 46px; translate: 72vw 40vh; }
    .qs__sun { --sz: clamp(110px, 30vw, 170px); left: 80%; }
    .qs__dawn { background: radial-gradient(70% 100% at 80% 100%, rgb(255 255 255 / 0.95) 0%, rgb(205 216 250 / 0.7) 30%, rgb(39 71 201 / 0.25) 55%, transparent 75%); }
    .qs__dock { left: var(--m); right: var(--m); bottom: 78px; flex-direction: column-reverse; align-items: stretch; gap: 12px; }
    .qs__you { align-self: flex-end; width: clamp(118px, 30vw, 160px); margin-right: 6px; }
    .qs__name, .qs__bell { top: auto; left: auto; right: calc(100% + 14px); translate: 0 0; text-align: right; }
    .qs__name { bottom: 34%; }
    .qs__bell { bottom: calc(34% - 22px); }
    .qs__bell .qs__swap--morning { left: auto; right: 0; translate: 0 0; }
    .qs__queue { width: min(100%, 330px); gap: 6px; }
    .qs__msg { padding: 8px 12px 9px; border-radius: 12px; }
    .qs__msgtext { font-size: 0.875rem; }
    .qs__msgwait { display: none; }
    .qs__bubble { right: 20%; max-width: min(300px, 78vw); }
    .qs__bubbletext { font-size: 0.9375rem; padding: 10px 16px; }
    .qs__foot { right: var(--m); bottom: 18px; }
  }
</style>
