---
// Bencho Toast stack (https://bencho.dev/blocks/toast-stack), ported from framer-motion to CSS and a small script.
// MIT, see ../arc/LICENSE.md. Three notices, newest in front; point at it or tab in and it fans out into a list.
// Dismiss one and it slides away while the next rises in at the front.
export interface Toast { kind: 'bell' | 'success' | 'info'; title: string; body: string }
interface Props { toasts: Toast[]; label: string }
const { toasts, label } = Astro.props;
const icons = {
  bell: '<path d="M10.27 21a2 2 0 0 0 3.46 0"/><path d="M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33"/>',
  success: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
};
---
<div class="b-toasts-wrap">
  <div class="b-toasts" role="region" aria-label={label} data-b-toasts data-pool={JSON.stringify(toasts)} data-icons={JSON.stringify(icons)}></div>
</div>

<script>
  type Toast = { kind: string; title: string; body: string };
  const H = 64, GAP = 10, PEEK = 14, SHOWN = 3;
  const listH = SHOWN * H + (SHOWN - 1) * GAP;
  const stackH = H + (SHOWN - 1) * PEEK;

  const setup = (root: HTMLElement) => {
    if (root.dataset.ready) return;
    root.dataset.ready = '';
    const pool: Toast[] = JSON.parse(root.dataset.pool || '[]');
    const icons: Record<string, string> = JSON.parse(root.dataset.icons || '{}');
    let next = 0;
    let open = false;
    let busy = false;

    // Where a toast sits: how far back it is, and whether the stack is open.
    const place = (k: number) => {
      if (open) return { y: (listH - listH) / 2 + (SHOWN - 1 - k) * (H + GAP), s: 1 };
      const d = Math.min(k, SHOWN - 1);
      return { y: (listH - stackH) / 2 + (SHOWN - 1 - d) * PEEK, s: 1 - d * 0.05 };
    };
    const items = () => [...root.querySelectorAll<HTMLElement>('.b-toast:not([data-out])')];
    const layout = () => {
      root.toggleAttribute('data-open', open);
      items().forEach((el, k) => {
        const p = place(k);
        el.style.transform = `translateY(${p.y}px) scale(${p.s})`;
        el.style.zIndex = String(SHOWN - k);
        el.toggleAttribute('data-front', k === 0);
        const hidden = !open && k !== 0;
        el.toggleAttribute('aria-hidden', hidden);
        el.querySelector('button')!.tabIndex = hidden ? -1 : 0;
      });
    };
    const make = (t: Toast) => {
      const el = document.createElement('div');
      el.className = 'b-toast';
      el.dataset.kind = t.kind;
      el.innerHTML = `<span class="b-toast__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[t.kind] ?? icons.info}</svg></span><span class="b-toast__text"><b></b><span></span></span><button type="button" class="b-toast__x"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>`;
      el.querySelector('b')!.textContent = t.title;
      el.querySelector('.b-toast__text span')!.textContent = t.body;
      el.querySelector('button')!.setAttribute('aria-label', `Dismiss: ${t.title}`);
      el.querySelector('button')!.addEventListener('click', () => dismiss(el));
      return el;
    };
    const add = (front: boolean) => {
      const el = make(pool[next++ % pool.length]);
      if (front) {
        // A new one rises in from just below the front.
        el.style.opacity = '0';
        el.style.transition = 'none';
        el.style.transform = `translateY(${place(0).y + 24}px)`;
        root.prepend(el);
        el.getBoundingClientRect();
        el.style.transition = '';
        el.style.opacity = '';
      } else root.append(el);
    };
    const dismiss = (el: HTMLElement) => {
      if (busy) return;
      busy = true;
      const had = document.activeElement === el.querySelector('button');
      el.dataset.out = '';
      el.style.opacity = '0';
      el.style.transform += ' translateX(60px)';
      setTimeout(() => {
        el.remove();
        add(true);
        layout();
        if (had) root.querySelector<HTMLElement>('.b-toast__x')?.focus();
        busy = false;
      }, 220);
    };

    for (let i = 0; i < SHOWN; i++) add(false);
    layout();
    const set = (v: boolean) => { if (open !== v) { open = v; layout(); } };
    root.addEventListener('pointerover', () => set(true));
    root.addEventListener('pointerout', (e) => { if (!root.contains(e.relatedTarget as Node | null)) set(false); });
    root.addEventListener('focusin', () => set(true));
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node | null)) set(false); });
  };
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-b-toasts]').forEach(setup));
</script>
